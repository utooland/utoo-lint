{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "https://raw.githubusercontent.com/utooland/utoo-lint/main/npm/utoo-lint/schema.json",
  "title": "utoo-lint configuration",
  "oneOf": [
    {
      "$ref": "#/definitions/configObject"
    },
    {
      "type": "array",
      "items": {
        "$ref": "#/definitions/configObject"
      }
    }
  ],
  "definitions": {
    "configObject": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "$schema": {
          "type": "string"
        },
        "rules": {
          "description": "ESLint-compatible rule severity map. Unknown rule names are rejected by utoo-lint.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/ruleSeverity"
          }
        },
        "settings": {
          "description": "Shared plugin settings.",
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "jest": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "version": {
                  "description": "Jest version used by version-aware Jest rules.",
                  "oneOf": [
                    { "type": "integer", "minimum": 1 },
                    { "type": "string", "pattern": "^[0-9]+(?:\\..*)?$" }
                  ]
                },
                "globalAliases": {
                  "description": "Additional global aliases for canonical Jest functions.",
                  "type": "object",
                  "additionalProperties": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 },
                    "uniqueItems": true
                  }
                }
              }
            }
          }
        },
        "files": {
          "description": "File globs this config entry applies to.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  }
                ]
              }
            }
          ]
        },
        "languageOptions": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "globals": {
              "description": "Globals declared for matching files, using ESLint flat config values. \"readonly\" accepts reads, \"writable\" also accepts writes, and \"off\" removes a built-in global.",
              "type": "object",
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": "string",
                    "enum": ["readonly", "readable", "writable", "writeable", "off"]
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "ignores": {
          "description": "File globs ignored by this config entry.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        }
      }
    },
    "ruleSeverity": {
      "oneOf": [
        {
          "type": "string",
          "enum": ["off", "warn", "warning", "error", "on", "0", "1", "2"]
        },
        {
          "type": "integer",
          "enum": [0, 1, 2]
        },
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": [
            {
              "$ref": "#/definitions/ruleSeverity"
            }
          ],
          "additionalItems": true
        }
      ]
    }
  }
}
