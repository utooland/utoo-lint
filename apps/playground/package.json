{
  "name": "@utoo/lint-playground",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "ev dev",
    "build": "ev build && node scripts/stage-static.mjs && node scripts/verify-dist.mjs",
    "inspect": "ev inspect --json",
    "test": "node --test scripts/*.test.mjs",
    "typecheck": "ev prepare && tsc --noEmit"
  },
  "dependencies": {
    "@evjs/ev": "0.3.21",
    "@monaco-editor/react": "4.7.0",
    "@utoo/lint-wasm": "workspace:*",
    "monaco-editor": "0.56.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "yuku": "0.22.1"
  },
  "devDependencies": {
    "@evjs/cli": "0.3.21",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "typescript": "7.x"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/utooland/utoo-lint.git",
    "directory": "apps/playground"
  }
}
